{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aae-retours-competitions-v2",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aae-retours-competitions"
    }
  ],
  "vars": {
    "ADMIN_TOKEN": "CHANGE-ME-IMMEDIATELY"
  }
}
